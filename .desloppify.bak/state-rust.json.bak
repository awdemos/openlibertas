    "review::.::holistic::mid_level_elegance::implicit_tool_call_handoff": {
      "id": "review::.::holistic::mid_level_elegance::implicit_tool_call_handoff",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Tool call flow spans 3 files with no clear seam contract",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "crates/openlibertas-core/src/backend.rs",
          "crates/openlibertas-tui/src/main.rs",
          "crates/openlibertas-tui/src/app.rs"
        ],
        "evidence": [
          "Flow: 1) backend.rs streams SSE with tool_call deltas, 2) main.rs receives ChatEvent::Text/Done and calls app methods, 3) app.rs finish_stream() attaches tool_calls to messages, 4) main.rs on Done checks pending_tool_calls and calls app.execute_tool_calls(), 5) app.rs builds tool result messages, 6) main.rs sends next chat request with tool results."
        ],
        "suggestion": "Encapsulate the tool call loop in a single type (e.g., ToolCallExecutor) that owns the state machine: collect deltas -> execute calls -> build results -> send followup. This type would live in core and be used by both TUI and server.",
        "reasoning": "",
        "summary_hash": "9f66e366"
      },
      "status": "open",
